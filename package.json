{
  "name": "@anujthecreator/expressnow",
  "version": "1.0.12",
  "type": "module",
  "bin": {
    "expressit": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build --compile src/index.ts --outfile dist/expressit",
    "build:platform": "bun scripts/build-platform.mjs",
    "dev": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "node -e \"const fs=require('fs'),p=JSON.parse(fs.readFileSync('package.json','utf8'));['linux-x64','linux-arm64','darwin-x64','darwin-arm64','windows-x64'].forEach(t=>{p.optionalDependencies['expressit-'+t]=p.version});fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n')\""
  },
  "optionalDependencies": {
    "expressit-linux-x64": "1.0.0",
    "expressit-linux-arm64": "1.0.0",
    "expressit-darwin-x64": "1.0.0",
    "expressit-darwin-arm64": "1.0.0",
    "expressit-windows-x64": "1.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "cac": "^7.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
